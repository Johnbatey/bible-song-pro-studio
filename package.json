{
  "name": "bible-song-pro-studio",
  "version": "3.2.0",
  "description": "Bible Song Pro - Professional Church Presentation & Streaming Software",
  "main": "src/electron/main.cjs",
  "author": "Johnson Olakotan",
  "license": "GPL-3.0-or-later",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@9.10.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Johnbatey/bible-song-pro-studio.git"
  },
  "scripts": {
    "start": "npm run build:renderer && unset ELECTRON_RUN_AS_NODE; electron .",
    "start:quick": "unset ELECTRON_RUN_AS_NODE; electron . --no-rebuild",
    "dev": "vite",
    "dev:electron": "npm run build:renderer && unset ELECTRON_RUN_AS_NODE; electron .",
    "build:renderer": "vite build",
    "build:mac": "vite build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --arm64",
    "build:mac:intel": "vite build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --x64",
    "build:mac:universal": "vite build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --universal",
    "build:win": "vite build && electron-builder --win",
    "build:linux": "vite build && electron-builder --linux",
    "dist:mac": "vite build && electron-builder --mac --arm64 --publish always",
    "dist:win": "vite build && electron-builder --win --publish always",
    "dist:linux": "vite build && electron-builder --linux --publish always",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test:live-scripture": "node scripts/test-live-scripture-parser.cjs",
    "verify:local-models": "node scripts/verify-local-models.cjs",
    "verify:ndi": "node scripts/verify-ndi-bundling.cjs",
    "verify:bibles": "node scripts/test-bible-canon.cjs && node scripts/check-bible-licensing.cjs",
    "verify:display-architecture": "node scripts/verify-display-architecture.cjs",
    "verify:window-resizing": "node scripts/verify-window-resizing.cjs",
    "verify:remote-architecture": "node scripts/verify-remote-architecture.cjs",
    "verify:program-surface": "unset ELECTRON_RUN_AS_NODE; electron scripts/verify-program-surface.cjs",
    "verify:audience-display": "unset ELECTRON_RUN_AS_NODE; electron scripts/verify-audience-display.cjs",
    "verify:display-parity": "unset ELECTRON_RUN_AS_NODE; electron scripts/verify-display-parity.cjs",
    "verify:display-fields": "node scripts/verify-display-fields.cjs",
    "verify:operator-layout": "unset ELECTRON_RUN_AS_NODE; electron scripts/verify-operator-layout.cjs",
    "verify:mode-switch": "unset ELECTRON_RUN_AS_NODE; electron scripts/verify-mode-switch.cjs",
    "verify:display-stack": "node scripts/verify-display-stack.cjs",
    "verify:deck-read": "node scripts/verify-deck-read.cjs",
    "verify:deck-ipc": "unset ELECTRON_RUN_AS_NODE; electron scripts/verify-deck-ipc.cjs",
    "verify:stage-architecture": "node scripts/verify-stage-architecture.cjs",
    "verify:port-fallback": "node scripts/verify-port-fallback.cjs",
    "verify:stage-display": "npm run build:renderer && unset ELECTRON_RUN_AS_NODE && electron scripts/verify-stage-display.cjs",
    "verify:dist-audience-display": "npm run build:renderer && unset ELECTRON_RUN_AS_NODE && electron scripts/verify-dist-audience-display.cjs",
    "verify:display-all": "npm run typecheck && npm run verify:display-fields && npm run verify:display-architecture && npm run verify:stage-architecture && npm run verify:port-fallback && npm run verify:window-resizing && npm run verify:display-stack && npm run verify:dist-audience-display && npm run verify:stage-layouts && npm run verify:stage-designer && npm run verify:song-arrange-ui && npm run verify:fonts-render",
    "verify:all": "npm run verify:bibles && npm run verify:ndi && npm run verify:fonts && npm run verify:media && npm run verify:slide-parity && npm run verify:song-arrange && npm run test:live-scripture && npm run verify:remote-architecture && npm run verify:display-all",
    "verify:stage-designer": "npm run build:renderer && unset ELECTRON_RUN_AS_NODE && electron scripts/verify-stage-designer.cjs",
    "verify:stage-layouts": "node scripts/verify-stage-layouts.cjs",
    "verify:media": "node scripts/verify-media-library.cjs",
    "verify:slide-parity": "node scripts/verify-slide-element-parity.cjs",
    "verify:fonts": "node scripts/verify-fonts.cjs",
    "verify:fonts-render": "npm run build:renderer && unset ELECTRON_RUN_AS_NODE && electron scripts/verify-fonts-render.cjs",
    "verify:song-arrange": "node scripts/verify-song-arrange.cjs",
    "verify:song-arrange-ui": "npm run build:renderer && unset ELECTRON_RUN_AS_NODE && electron scripts/verify-song-arrange-ui.cjs"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "electron-winstaller",
      "esbuild",
      "koffi",
      "sharp"
    ]
  },
  "build": {
    "appId": "com.biblesongpro.studio",
    "productName": "Bible Song Pro Studio",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "directories": {
      "buildResources": "assets",
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "assets/**/*",
      "!assets/bin/**/*",
      "src/electron/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/node_modules/koffi/**/*",
      "**/node_modules/@koromix/**/*",
      "**/node_modules/sharp/**/*",
      "**/node_modules/@img/**/*"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "assets/icons/bible-song-pro-icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "identity": null,
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "notarize": false,
      "entitlements": "assets/entitlements.mac.plist",
      "entitlementsInherit": "assets/entitlements.mac.plist",
      "extraResources": [
        {
          "from": "assets/bin/ndi/darwin",
          "to": "bin/ndi",
          "filter": ["**/*"]
        }
      ],
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Bible Song Pro needs microphone access for live speech transcription and voice audio input.",
        "NSCameraUsageDescription": "Bible Song Pro needs camera access for video capture and live feeds.",
        "NSCameraUseContinuityCameraDeviceType": true,
        "NSScreenCaptureUsageDescription": "Bible Song Pro needs screen capture access to project presentation displays.",
        "NSLocalNetworkUsageDescription": "Bible Song Pro uses the local network to broadcast NDI video and connect stage and remote displays.",
        "NSDesktopFolderUsageDescription": "Bible Song Pro needs access to your Desktop to import presentation media, videos, and graphics.",
        "NSDocumentsFolderUsageDescription": "Bible Song Pro needs access to your Documents folder to save and load service projects and song libraries.",
        "NSDownloadsFolderUsageDescription": "Bible Song Pro needs access to your Downloads folder to import media assets and Bible translations.",
        "NSBonjourServices": [
          "_ndi._tcp",
          "_ndi._udp"
        ]
      }
    },
    "win": {
      "icon": "assets/icons/bible-song-pro-icon.ico",
      "target": [
        "nsis"
      ],
      "publisherName": "Bible Song Pro",
      "extraResources": [
        {
          "from": "assets/bin/ndi/win32-x64",
          "to": "bin/ndi",
          "filter": ["**/*"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Bible Song Pro Studio",
      "uninstallDisplayName": "Bible Song Pro Studio",
      "differentialPackage": false,
      "runAfterFinish": true
    },
    "linux": {
      "icon": "assets/icons/bible-song-pro-icon.png",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "AudioVideo",
      "maintainer": "Johnson Olakotan <support@biblesongpro.com>",
      "extraResources": [
        {
          "from": "assets/bin/ndi/linux-x64",
          "to": "bin/ndi",
          "filter": ["**/*"]
        }
      ]
    }
  },
  "dependencies": {
    "@deepgram/sdk": "^3.6.0",
    "@huggingface/transformers": "^3.8.1",
    "animejs": "^3.2.2",
    "dockview": "^7.0.4",
    "dockview-react": "^7.0.4",
    "jszip": "^3.10.1",
    "koffi": "^3.1.2",
    "lodash-es": "^4.17.21",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0",
    "sharp": "^0.34.5",
    "sql.js": "^1.14.2",
    "uuid": "^11.0.0",
    "ws": "^8.18.0",
    "zustand": "^5.0.0"
  },
  "optionalDependencies": {
    "@img/sharp-darwin-arm64": "0.34.5",
    "@img/sharp-darwin-x64": "0.34.5",
    "@img/sharp-libvips-darwin-arm64": "1.2.4",
    "@img/sharp-libvips-darwin-x64": "1.2.4",
    "@img/sharp-libvips-linux-x64": "1.2.4",
    "@img/sharp-libvips-win32-x64": "1.2.4",
    "@img/sharp-linux-x64": "0.34.5",
    "@img/sharp-win32-x64": "0.34.5",
    "@koromix/koffi-darwin-arm64": "3.1.2",
    "@koromix/koffi-darwin-x64": "3.1.2",
    "@koromix/koffi-linux-x64": "3.1.2",
    "@koromix/koffi-win32-x64": "3.1.2"
  },
  "devDependencies": {
    "@electron/notarize": "^3.1.1",
    "@types/lodash-es": "^4.17.12",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.5.0",
    "@vitejs/plugin-react": "^4.4.0",
    "concurrently": "^9.0.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "wait-on": "^8.0.0"
  }
}
