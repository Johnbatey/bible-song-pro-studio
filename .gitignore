# Dependencies
node_modules/

# Build output (vite renderer bundle + electron-builder artifacts)
dist/
release/
out/
artifacts/
*.dmg
*.zip
*.AppImage
*.deb
*.exe

# Vendored package tarballs — installed from npm, not needed in history
*.tgz

# Slide-engine parity test decks. Staged locally per scripts/parity-slide-engine.md;
# the verify scripts skip cleanly when they are absent.
public/__parity/

# Logs
*.log
npm-debug.log*

# Editor / OS
.DS_Store
.vscode/
.idea/

# Local secrets. API keys live in the app's userData settings.json, never here —
# this is belt-and-braces in case anything is ever written to the project dir.
# Anchored to the project root so a future src/**/settings.json is not dropped silently.
.env
.env.local
/settings.json
.opencode
